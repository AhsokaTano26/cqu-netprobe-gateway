# ---------------------------------------------------------------------------
# CQU NetProbe Gateway 配置
# 复制为 .env 后修改。真正的 .env 不要提交到仓库（.gitignore 已排除）。
# ---------------------------------------------------------------------------

# 从 Docker Hub 拉取的镜像。只有 fork 或换镜像源时才需要改 IMAGE_REPO。
# 这两个变量由 docker-compose.yml 读取，Gateway 本身不读。
IMAGE_REPO=tano26/cqu-netprobe-gateway

# 把部署固定到某个已发布的版本：取消下面一行的注释并改成目标 tag。
# 不设时 compose 拉 :latest；此时本地 `docker compose build` 出来的二进制
# 在启动日志里自称 "dev"，而不会冒称自己是某个正式版本。
#IMAGE_TAG=v0.1.0

# 公开 listener：push API 与管理界面，位于容器内。
# 必须绑 0.0.0.0：宿主机的发布端口是转发到容器 IP 的，
# 绑回环（127.0.0.1）会导致从容器外根本连不上。
LISTEN_ADDR=0.0.0.0:8080

# 容器内 8080 发布到宿主机的端口。与 LISTEN_ADDR 相互独立 ——
# 后者只决定容器内的绑定地址。要换端口只改这一个。
LISTEN_HOST_PORT=8080

# 指标 listener。保持回环，让 Prometheus 在本机抓取。
METRICS_ADDR=127.0.0.1:9090

# SQLite 数据库目录。需要挂成卷。
DATA_DIR=/data

# 容器进程以哪个 uid:gid 运行。默认值与镜像里的 nonroot 用户一致（65532:65532）。
# 原生 Linux 上，bind mount 进来的 ./data 属于部署用户，65532 无法在其中创建
# netprobe.db。两种改法任选其一：把这里改成 ./data 的属主（id -u / id -g），
# 或者把 ./data 的属主 chown 成 65532。
# 这两个变量由 docker-compose.yml 读取，Gateway 本身不读。
PUID=65532
PGID=65532

# 用于生成探针创建后展示的 Push Endpoint，以及决定管理界面 Session Cookie
# 是否带 Secure 标志。填对外访问的 HTTPS 地址。
PUBLIC_BASE_URL=https://netprobe.example.com

# 管理员账号。
# ADMIN_PASSWORD 留空则启动时随机生成一个，并在日志里打印一次。其哈希存入
# SQLite，因此重启后仍然有效。要重置密码，删掉 settings 表里的
# admin_password_hash 行后重启。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 在线判定与测量值 stale 判定共用的阈值。协议 v1 固定为 30 秒，
# 改动即偏离协议，且会同时影响在线状态与指标的新鲜度判定。
ONLINE_THRESHOLD=30s

# 每个探针的推送限流：每 RATE_LIMIT 允许一个请求，允许 RATE_LIMIT_BURST 个突发。
# 协议 v1 §21 推荐 5s 与 3。
RATE_LIMIT=5s
RATE_LIMIT_BURST=3

# 公开注册页（GET / 与 POST /）。同一 IP 每 REGISTER_LIMIT 可创建一个探针，
# 允许 REGISTER_LIMIT_BURST 个突发。比上面的每探针限流宽松得多 ——
# 一个人也就注册一两次，这项存在的意义是阻止脚本灌满探针表，
# 而不是限制正常访问。
#
# 自助注册的探针创建即可用：Token 立刻生效，没有审批环节。
REGISTER_LIMIT=1h
REGISTER_LIMIT_BURST=3

# 公开注册页最多能创建多少个探针。上面的注册限流管的是「一个地址能多快创建」，
# 这一项管的是「总共能存在多少」—— 长期来看，后者才是保护 Prometheus 时序基数
# 的那道闸。
#
# 只作用于公开注册页。管理员在 /admin/probes/new 创建的探针不受此限：
# 表满了，更不能挡住唯一能清空它的人。必须 >= 1；填一个很大的值等于取消上限。
MAX_PROBES=500

# 其 X-Forwarded-For 可被采信的网段，也就是你的反向代理。没有代理就不要填：
# 留空时该头被完全忽略、直接用直连地址 —— 这是直接对外部署时最正确的做法。
#
# 前面有 nginx / Caddy / PaaS 的负载均衡时必须填，否则所有请求的来源地址都是
# 代理的，四件事会静默地退化成「全局共享一份」：
#   - Token 猜测限流（一个人猜错，全集群被限流）
#   - 公开注册限流（前三个访客用完全部额度）
#   - /metrics 白名单（要么全部拒绝，要么只能全部放行）
#   - 日志里的 remote_ip（每一条都是代理地址）
#
# 绝对不要填 0.0.0.0/0 或 ::/0 —— Gateway 会拒绝启动。那不是「信任我的代理」，
# 而是「信任任何人」：任何能直连到端口的人都能自称任意来源地址。
#
# nginx 侧必须追加而不是覆盖：
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
TRUSTED_PROXY_CIDRS=

# 除回环外允许抓取 /metrics 的网段，逗号分隔。
# 留空表示「仅回环」。
METRICS_ALLOWED_CIDRS=

# 取值：debug | info | warn | error
LOG_LEVEL=info
