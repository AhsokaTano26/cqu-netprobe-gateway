# ---------------------------------------------------------------------------
# CQU NetProbe Gateway configuration
# Copy to .env and edit. Never commit the real .env.
# ---------------------------------------------------------------------------

# Image pulled from Docker Hub. IMAGE_REPO only needs changing for a fork or a
# mirror. Both variables are read by docker-compose.yml, not by the gateway.
IMAGE_REPO=tano/cqu-netprobe-gateway

# Pin a deployment to a released tag by uncommenting this. Left unset, compose
# pulls :latest, and a local `docker compose build` stamps itself as "dev"
# rather than claiming in its startup log to be a release.
#IMAGE_TAG=v0.1.0

# Public listener: push API and admin UI, inside the container.
# Must bind 0.0.0.0: the published port is forwarded to the container IP, so a
# loopback value (127.0.0.1) is unreachable from outside the container.
LISTEN_ADDR=0.0.0.0:8080

# Host port the container's 8080 is published on. Independent of LISTEN_ADDR,
# which only controls the in-container bind address. Change this one to move
# the service to a different host port.
LISTEN_HOST_PORT=8080

# Metrics listener. Keep this on loopback and let Prometheus scrape locally.
METRICS_ADDR=127.0.0.1:9090

# SQLite database directory. Mount this as a volume.
DATA_DIR=/data

# uid:gid the container runs as. Defaults match the image's nonroot user
# (65532:65532). On a native Linux host the bind-mounted ./data is owned by
# the deploying user, and 65532 cannot create netprobe.db there — set these to
# the owner of ./data (id -u / id -g), or chown ./data to 65532 instead.
PUID=65532
PGID=65532

# Used for the Push Endpoint shown after probe creation and to decide whether
# the admin session cookie gets the Secure flag. Set it to your HTTPS URL.
PUBLIC_BASE_URL=https://netprobe.example.com

# Admin credentials.
# Leave ADMIN_PASSWORD empty to have the gateway generate one and print it
# once at startup. The hash is stored in SQLite, so the password survives
# restarts. To reset it, delete the admin_password_hash row from the settings
# table and restart.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Online and stale threshold. Protocol v1 fixes this at 30 seconds; changing it
# deviates from the protocol and affects both online status and metric staleness.
ONLINE_THRESHOLD=30s

# Per-probe rate limit: one request per RATE_LIMIT, with RATE_LIMIT_BURST
# requests allowed back to back. Protocol v1 §21 recommends 5s and 3.
RATE_LIMIT=5s
RATE_LIMIT_BURST=3

# Public probe registration (GET / and POST /). One IP may create one probe per
# REGISTER_LIMIT, with REGISTER_LIMIT_BURST allowed back to back. Much looser
# than the per-probe limit above — a person registers once or twice, so this
# exists to stop scripts filling the probes table, not to shape normal traffic.
#
# Self-registered probes are enabled on arrival: their token works immediately,
# with no approval step.
REGISTER_LIMIT=1h
REGISTER_LIMIT_BURST=3

# How many probes the public registration page will create. The register limit
# above bounds how fast one address can create probes; this bounds how many can
# exist, which is what protects Prometheus cardinality over a long period.
#
# It applies to the public page only. Probes an administrator creates at
# /admin/probes/new are not capped: a full table must not stop the person who
# can empty it. Must be >= 1; a very large value effectively disables the cap.
MAX_PROBES=500

# Comma-separated CIDRs allowed to scrape /metrics, in addition to loopback.
# An empty value means loopback only.
METRICS_ALLOWED_CIDRS=

# debug | info | warn | error
LOG_LEVEL=info
